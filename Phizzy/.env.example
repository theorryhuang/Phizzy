# Firebase web app config (Firebase console -> Project settings -> Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional overrides (defaults shown)
# EXPO_PUBLIC_STORAGE_VIDEOS_PATH=videos
# EXPO_PUBLIC_STORAGE_AVATARS_PATH=avatars
# EXPO_PUBLIC_PROGRAMS_COLLECTION=programs
# EXPO_PUBLIC_DEFAULT_USER_ID=default-user
# EXPO_PUBLIC_USE_DEMO_PROGRAM=true
